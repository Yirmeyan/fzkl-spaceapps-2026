# Copy this file to .env for local development. Never commit .env.
# Every setting has a safe default, so the service also starts without a .env file.

# development, staging or production. Shown in logs only.
SPX_ENVIRONMENT=development

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
SPX_LOG_LEVEL=INFO

# Web pages allowed to call the API from a browser: * for every origin,
# or origins separated by commas, such as http://localhost:5173,https://example.org
SPX_ALLOWED_ORIGINS=*

# Search service of the SPHEREx archive, and the data releases to search, separated by commas.
# When two releases hold the same exposure, the first one wins.
SPX_SIA_URL=https://irsa.ipac.caltech.edu/SIA
SPX_SIA_COLLECTIONS=spherex_dr1,spherex_qr3

# Storage that holds the SPHEREx files, and its region. Exposures stored elsewhere are ignored.
SPX_ARCHIVE_BUCKET=nasa-irsa-spherex
SPX_ARCHIVE_REGION=us-east-1

# Radius of the search around the target, in degrees.
SPX_SEARCH_RADIUS_DEG=0.01

# Longest wait for one answer of the archive, then longest time one request spends on the
# archive, all searches and attempts together, in seconds. Keep the second one below the
# request timeout of the host, 60 seconds on Cloud Run.
SPX_ARCHIVE_TIMEOUT_S=25
SPX_ARCHIVE_BUDGET_S=45

# Attempts before the service answers 503, and most exposures asked for one position.
# The archive fails in bursts of a few seconds: the pauses between attempts grow from
# 1 to 3 seconds, about 12 seconds in all for 6 attempts.
SPX_ARCHIVE_ATTEMPTS=6
SPX_MAX_EXPOSURES=5000
# A list of exposures is reused for the first duration, in seconds,
# and up to the second one when the archive does not answer.
SPX_SEARCH_FRESH_S=3600
SPX_SEARCH_STALE_S=86400

# Reads of parts of the files: longest wait for one read in seconds, attempts before the
# service answers 503, and most reads in flight at once.
SPX_STORAGE_TIMEOUT_S=10
SPX_STORAGE_ATTEMPTS=3
SPX_STORAGE_CONCURRENCY=32

# Name resolver of the CDS: its mirror at Harvard, then the main site when the mirror
# fails. Longest wait for one answer, in seconds.
SPX_RESOLVER_URLS=https://vizier.cfa.harvard.edu/viz-bin/nph-sesame,https://cds.unistra.fr/cgi-bin/nph-sesame
SPX_RESOLVER_TIMEOUT_S=10
