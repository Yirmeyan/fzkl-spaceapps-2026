{
  "name": "spherex-explorer-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "SPHEREx Explorer web client for NASA Space Apps 2026.",
  "type": "module",
  "scripts": {
    "samples": "node scripts/copy-samples.mjs",
    "predev": "node scripts/copy-samples.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-samples.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^29.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
